# Copy to .env for local dev. On Railway, set these in the project's Variables tab.
# Without keys the site still works — bookings fall back to SMS.

# Stripe — required for card-on-file (use sk_test_ while building, sk_live_ in prod)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx   # from the webhook you create (see README)

# Twilio — required for returning-client verification codes + texting Chris
TWILIO_SID=ACxxxxxxxx
TWILIO_TOKEN=xxxxxxxx
TWILIO_FROM=+15551234567          # your Twilio number

# Chris's phone — where booking texts get sent (falls back to config.json)
BARBER_PHONE=+15550123456

# Optional
PORT=3000
NODE_ENV=production               # set on Railway — hides dev codes from API responses
